{
  "name": "browser-mcp",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "PLAYWRIGHT_BROWSERS_PATH=./data/pw-browsers BROWSER_MCP_DATA_ROOT=./data tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "PLAYWRIGHT_BROWSERS_PATH=./data/pw-browsers BROWSER_MCP_DATA_ROOT=./data node dist/server.js",
    "install:browsers": "PLAYWRIGHT_BROWSERS_PATH=./data/pw-browsers playwright install --with-deps chromium",
    "browser:task": "PLAYWRIGHT_BROWSERS_PATH=./data/pw-browsers BROWSER_MCP_DATA_ROOT=./data node dist/tasks/cloudTask.js",
    "browser:smoke": "PLAYWRIGHT_BROWSERS_PATH=./data/pw-browsers BROWSER_MCP_DATA_ROOT=./data node dist/tasks/smoke.js",
    "test": "npm run build -- --pretty false && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "playwright": "^1.54.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
