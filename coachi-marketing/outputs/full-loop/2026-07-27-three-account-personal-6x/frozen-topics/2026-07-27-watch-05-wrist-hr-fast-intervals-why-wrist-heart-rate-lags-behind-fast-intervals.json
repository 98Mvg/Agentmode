          "slide_number": 1,
          "role": "hook",
          "text": "Why COROS Auto Lock matters when watch buttons get pressed"
        },
        {
          "slide_number": 2,
          "role": "felt_moment",
          "text": "A sleeve or bent wrist can touch the dial mid-run."
        },
        {
          "slide_number": 3,
          "role": "hidden_cost",
          "text": "An accidental press can pause or finish the activity."
        },
        {
          "slide_number": 4,
          "role": "fix",
          "text": "Open System, More Settings, then Auto Lock."
        },
        {
          "slide_number": 5,
          "role": "fix",
          "text": "Choose the hold or scroll option for Activity Mode."
        },
        {
          "slide_number": 6,
          "role": "proof",
          "text": "The Back/Lap button still records a lap while locked."
        },
        {
          "slide_number": 7,
          "role": "cta",
          "text": "Save this before your next COROS run."
        }
