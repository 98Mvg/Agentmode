          "slide_number": 1,
          "role": "hook",
          "text": "Why waiting until minute 45 can ruin your long run"
        },
        {
          "slide_number": 2,
          "role": "felt_moment",
          "text": "You feel fine early, so eating seems completely unnecessary."
        },
        {
          "slide_number": 3,
          "role": "hidden_cost",
          "text": "When hunger arrives, concentration and pace may already be slipping."
        },
        {
          "slide_number": 4,
          "role": "fix",
          "text": "On longer runs, carry fuel you have already tested."
        },
        {
          "slide_number": 5,
          "role": "fix",
          "text": "Practice eating before you feel empty, not once the run unravels."
        },
        {
          "slide_number": 6,
          "role": "proof",
          "text": "Good fueling keeps the final section about running, not finding food."
        },
        {
          "slide_number": 7,
          "role": "cta",
          "text": "Save this before your next longer run."
        }
