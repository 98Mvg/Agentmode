          "role": "hook",
          "text": "Lock your Garmin before rain or sleeves press the screen"
        },
        {
          "slide_number": 2,
          "role": "felt_moment",
          "text": "Wet sleeves can brush a touchscreen while you keep running."
        },
        {
          "slide_number": 3,
          "role": "hidden_cost",
          "text": "One accidental touch can change pages or trigger controls."
        },
        {
          "slide_number": 4,
          "role": "fix",
          "text": "Add Lock Device to the Garmin Controls menu."
        },
        {
          "slide_number": 5,
          "role": "fix",
          "text": "Some models can also assign Lock Device as a Hot Key."
        },
        {
          "slide_number": 6,
          "role": "proof",
          "text": "Hold a button when you need the controls again."
        },
        {
          "slide_number": 7,
          "role": "cta",
          "text": "Save this before your next wet Garmin run."
        }
      ],
