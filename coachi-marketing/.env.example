MARKETING_SUPABASE_URL=https://zdpnherzigrywjynasqf.supabase.co
MARKETING_SUPABASE_SECRET_KEY=
MARKETING_SUPABASE_PUBLIC_BUCKET=slideshow-public
MARKETING_SUPABASE_PRIVATE_BUCKET=slideshow-private

# Marathon TikTok uses a dedicated project and never falls back to the shared
# marketing project. Use a secret or service-role storage credential here.
MARKETING_SUPABASE_URL_MARATHON=
MARKETING_SUPABASE_SECRET_KEY_MARATHON=
MARKETING_SUPABASE_SERVICE_ROLE_KEY_MARATHON=

# OpenAI Images API for slideshow hook image generation.
# Keep this secret local. Do not commit a real key.
OPENAI_API_KEY=
OPENAI_IMAGE_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1024x1536
OPENAI_IMAGE_QUALITY=high

# Slideshow queue and Postiz are dry-run unless POSTIZ_ENABLE_LIVE_POSTING=1.
REDIS_URL=redis://127.0.0.1:6379
POSTIZ_URL=http://localhost:4007
POSTIZ_PUBLIC_API_BASE=http://localhost:4007/api/public/v1
POSTIZ_API_KEY=
POSTIZ_ENABLE_LIVE_POSTING=0
# Default/legacy TikTok account id. Keep this as the main Everyday Runner Lab integration.
POSTIZ_TIKTOK_ACCOUNT_ID=
# Explicit TikTok account profiles for multi-account scheduling.
POSTIZ_TIKTOK_DEFAULT_ACCOUNT=main
POSTIZ_TIKTOK_ACCOUNT_ID_MAIN=
POSTIZ_TIKTOK_ACCOUNT_ID_WATCH=
POSTIZ_TIKTOK_ACCOUNT_ID_MARATHON=
# Optional alias if a script or local setup calls the second account "secondary".
POSTIZ_TIKTOK_ACCOUNT_ID_SECONDARY=
# Optional alias if a script or local setup calls the marathon account "third".
POSTIZ_TIKTOK_ACCOUNT_ID_THIRD=
POSTIZ_INSTAGRAM_ACCOUNT_ID=
POSTIZ_TIKTOK_AUTO_ADD_MUSIC=yes
